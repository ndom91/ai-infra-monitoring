{
  "name": "ai-infra-monitor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy --keep-vars",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "collect": "tsx --env-file-if-exists=.env scripts/collect.ts",
    "alerts": "tsx --env-file-if-exists=.env scripts/alerts.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "db:restore": "tsx --env-file-if-exists=.env scripts/restore.ts",
    "check:bundle": "! grep -rlE \"@libsql|node:fs|drizzle-orm\" .output/public",
    "check:manual": "tsx scripts/check-manual.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=24"
  }
}
