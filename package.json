{
	"name": "ai-infra-monitor",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.12.1",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "vite preview --port 4173",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
		"collect": "tsx --env-file-if-exists=.env scripts/collect.ts"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"@tanstack/react-router": "^1.170.44",
		"@tanstack/react-start": "^1.169.2",
		"chart.js": "^4.5.1",
		"drizzle-orm": "^0.45.4",
		"react": "^19.3.1",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "^19.3.1",
		"valibot": "^1.5.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	}
}
